# Netlify Function /api/concerts — nastavuje se v Netlify UI (Environment variables, kontext Production,
# "Contains secret values"). Lokálně do souboru .env (je v .gitignore). Tady jen názvy, žádné hodnoty.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CONCERTS_ENABLED=
# jen lokálně: CONCERTS_SOURCE=fixtures → data z tests/fixtures/google-events.json místo Googlu
CONCERTS_SOURCE=
